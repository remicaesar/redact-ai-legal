# Copy to .env and fill in real values. Loaded by app.py via python-dotenv;
# real shell environment variables take precedence over this file.
LEGAL_ANALYZER_ADMIN_USERNAME=admin
LEGAL_ANALYZER_ADMIN_PASSWORD=change-this-local-password
LEGAL_ANALYZER_SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_hex(32))"
