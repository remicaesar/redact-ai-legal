# Copy to .env and fill in real values. Loaded by app.py via python-dotenv;
# real shell environment variables take precedence over this file.
LEGAL_ANALYZER_ADMIN_USERNAME=admin
LEGAL_ANALYZER_ADMIN_PASSWORD=change-this-local-password

# Signs the session cookie. There is no hardcoded fallback: leave this unset and
# each process generates its own ephemeral key, so sessions do not survive a
# restart and do not work across gunicorn workers. Required for anything beyond
# a single local process.
LEGAL_ANALYZER_SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_hex(32))"

# Largest request body accepted, in bytes. Defaults to 100000000 (100 MB), the
# same ceiling the ZIP extractor enforces. Oversized requests get a 413.
# LEGAL_ANALYZER_MAX_UPLOAD_BYTES=100000000

# Set to 1 when serving over TLS so the session cookie carries the Secure flag.
# Leave unset for plain http on 127.0.0.1 — a Secure cookie is never sent over
# http and login would fail with no visible reason.
# LEGAL_ANALYZER_HTTPS=1

# Set to 1 to enable the Werkzeug debugger on `python3 app.py`. Off by default:
# the debugger executes arbitrary code from the browser on any traceback.
# LEGAL_ANALYZER_DEBUG=1

# Login throttle. Counted per (username, address) and per address, over a
# rolling window; the second cap is what stops one address trying a single
# password against many usernames. Behind a proxy that does not pass the client
# address through, every caller shares one bucket — raise the per-address cap.
# LEGAL_ANALYZER_LOGIN_MAX_ATTEMPTS=5
# LEGAL_ANALYZER_LOGIN_MAX_ATTEMPTS_PER_ADDR=20
# LEGAL_ANALYZER_LOGIN_WINDOW_SECONDS=900
